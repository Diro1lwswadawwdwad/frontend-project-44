[356.040752, "o", "cat > bin/brain-prime.js << 'EOF'\r\n\r#!/usr/bin/env node\r\n\r\n\rimport { runGame } from '../src/index.js';\r\n\r\n\r// Функция проверки простоты числа\r\n\rconst isPrime = (num) => {\r\n\r\u001b[7m    if (num < 2) return false;\u001b[27m\r\n\r\u001b[7m    for (let i = 2; i <= Math.sqrt(num); i++) {\u001b[27m\r\n\r\u001b[7m        if (num % i === 0) return false;\u001b[27m\r\n\r\u001b[7m    }\u001b[27m"]
[356.041273, "o", "\r\n\r\u001b[7m    return true;\u001b[27m\r\n\r\u001b[7m};\u001b[27m\r\n\r\n\r\u001b[7m// Функция генерации случайного числа\u001b[27m\r\n\r\u001b[7mconst getRandomNumber = () => Math.floor(Math.random() * 99) + 2; // числа от 2 до 100\u001b[27m\r\n\r\n\r\u001b[7m// Функция генерации вопроса и ответа\u001b[27m\r\n\r\u001b[7mconst generateRound = () => {\u001b[27m\r\n\r\u001b[7m    const number = getRandomNumber();\u001b[27m\r\n\r\u001b[7m    const question = String(number);\u001b[27m\r\n\r\u001b[7m    const correctAnswer = isPrime(number) ? 'yes' : 'no';\u001b[27m\r\n\r\u001b[7m    \u001b[27m\r\n\r\u001b[7m    return { question, correctAnswer };\u001b[27m\r\u001b[7m};\u001b[27m\r\u001b[7mconst gameDescription = 'Answer \"yes\" if given number is prime. Otherwise answer \"no\".';\u001b[27m\r\u001b[7mrunGame(gameDescription, generateRound);\u001b[27m\r\u001b[7mEOF\u001b[27m"]
[356.723973, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\r    if (num < 2) return false;\r\n\r    for (let i = 2; i <= Math.sqrt(num); i++) {\r\n\r        if (num % i === 0) return false;\r\n\r    }\r\n\r    return true;\r\n\r};\r\n\r\n\r// Функция генерации случайного числа\r\n\rconst getRandomNumber = () => Math.floor(Math.random() * 99) + 2; // числа от 2 до 100\r\n\r\n\r// Функция генерации вопроса и ответа\r\n"]
[356.724195, "o", "\rconst generateRound = () => {\r\n\r    const number = getRandomNumber();\r\n\r    const question = String(number);\r\n\r    const correctAnswer = isPrime(number) ? 'yes' : 'no';\r\n\r    \r\n\r    return { question, correctAnswer };\r};\rconst gameDescription = 'Answer \"yes\" if given number is prime. Otherwise answer \"no\".';\rrunGame(gameDescription, generateRound);\rEOF\r\n\u001b[?2004l\r"]
