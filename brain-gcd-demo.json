[157.177418, "o", "cat > bin/brain-progression.js << 'EOF'\r\n\r#!/usr/bin/env node\r\n\r\n\rimport { runGame } from '../src/index.js';\r\n\r\n"]
[157.177859, "o", "\r// Функция генерации случайного числа в диапазоне\r\n\rconst getRandomNumber = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;\r\n\r\n\r// Функция генерации арифметической прогрессии\r\n\rconst generateRound = () => {\r\n\r    const length = 10; // Длина прогрессии\r\n\r    const start = getRandomNumber(1, 20); // Начальное число от 1 до 20\r\n\r    const step = getRandomNumber(1, 10); // Шаг прогрессии от 1 до 10\r\n\r    const hiddenIndex = getRandomNumber(0, length - 1); // Индекс скрытого элемента\r\n\r\u001b[7m    \u001b[27m\r\n\r\u001b[7m    // Создаём массив прогрессии\u001b[27m\r\n\r\u001b[7m    const progression = [];\u001b[27m\r\n\r\u001b[7m    for (let i = 0; i < length; i++) {\u001b[27m\r\n\r\u001b[7m        progression.push(start + i * step);\u001b[27m\r\n\r\u001b[7m    }\u001b[27m\r\n\r\u001b[7m    \u001b[27m\r\n\r\u001b[7m    // Сохраняем правильный ответ\u001b[27m\r\n\r\u001b[7m    const correctAnswer = String(progression[hiddenIndex]);\u001b[27m\r\n\r\u001b[7m    \u001b[27m\r\u001b[7m    // Заменяем скрытый элемент на '..'\u001b[27m\r\u001b[7m    progression[hiddenIndex] = '..';\u001b[27m\r\u001b[7m    \u001b[27m\r\u001b[7m    // Формируем вопрос\u001b[27m\r\u001b[7m    const question = progression.join(' ');\u001b[27m\r\u001b[7m    \u001b[27m\r\u001b[7m    return { question, correctAnswer };\u001b[27m\r\u001b[7m};\u001b[27m\r\u001b[7mconst gameDescription = 'What number is missing in the progression?';\u001b[27m\r\u001b[7mrunGame(gameDescription, generateRound);\u001b[27m\r\u001b[7mEOF\u001b[27m"]
[158.157608, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\r    \r\n\r    // Создаём массив прогрессии\r\n\r    const progression = [];\r\n\r    for (let i = 0; i < length; i++) {\r\n\r        progression.push(start + i * step);\r\n\r    }\r\n\r    \r\n\r    // Сохраняем правильный ответ\r\n\r    const correctAnswer = String(progression[hiddenIndex]);\r\n"]
[158.157872, "o", "\r    \r    // Заменяем скрытый элемент на '..'\r    progression[hiddenIndex] = '..';\r    \r    // Формируем вопрос\r    const question = progression.join(' ');\r    \r    return { question, correctAnswer };\r};\rconst gameDescription = 'What number is missing in the progression?';\rrunGame(gameDescription, generateRound);\rEOF\r\n"]
